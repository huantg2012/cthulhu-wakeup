extends SceneTree
## Offline only. Freeze approved compositions through the original NPR pipeline.
## The game loads the saved textures; it never imports this build tool.
const NPR = preload("res://src/art_generation/post/npr_pipeline.gd")
const SOURCE := "res://docs/art/visual-generation/card-illustration-study/full-deck-drafts/"
const OUTPUT := "res://assets/ui/card-illustrations/painted-deck/"
const REVIEW := "res://docs/art/visual-generation/card-illustration-study/painted-deck/"
func _initialize() -> void:
	run.call_deferred()
func fail(message: String) -> void:
	push_error(message)
	quit(1)
func run() -> void:
	var doc: Variant = JSON.parse_string(FileAccess.get_file_as_string(SOURCE+"manifest.json"))
	if not doc is Dictionary or doc.get("cards",[]).size()!=72:
		fail("Expected the approved 72 card surfaces"); return
	var sample_only := "--sample" in OS.get_cmdline_user_args()
	var selected := ["power_listen","route_private_devotion","anchor_bind","relic_echo_bell","event_03","resist_seize"]
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUTPUT))
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(REVIEW+"art"))
	var pipeline := NPR.new()
	root.add_child(pipeline)
	# These are painted signs and objects, not luminous planets. Retain the
	# original painterly pass, but do not turn every pale pigment into a lamp.
	pipeline.down_mat.set_shader_parameter("threshold",0.90)
	pipeline.down_mat.set_shader_parameter("knee",0.10)
	var records := {}
	var images := {}
	for card: Dictionary in doc.cards:
		var key: String = card.illustration_key
		records[card.id]=key
		if images.has(key) or (sample_only and not key in selected): continue
		var source_path: String = SOURCE+card.art_path
		var source := Image.load_from_file(source_path)
		if source==null or source.is_empty(): fail("Missing approved source: "+source_path); return
		# Explicit, stable seed per approved drawing; unrelated to any gameplay RNG.
		var seed_value := int(key.sha256_text().substr(0,8).hex_to_int()%1000000)
		var world := {"styleIndex":0,"styleSid":0,"palette":0,"worldSeed":seed_value}
		var final: Image = await pipeline.apply(source,world,null,true)
		if final==null or final.is_empty(): fail("Post failed: "+key); return
		# Source drafts are 512px; keep that resolution for fixed card assets.
		final.resize(512,512,Image.INTERPOLATE_LANCZOS)
		if final.save_png(REVIEW+"art/"+key+".png")!=OK: fail("PNG write failed: "+key); return
		var texture := ImageTexture.create_from_image(final)
		if ResourceSaver.save(texture,OUTPUT+key+".res",ResourceSaver.FLAG_COMPRESS)!=OK:
			fail("Texture write failed: "+key); return
		images[key]={"source":source_path,"source_sha256":FileAccess.get_sha256(source_path),
			"resource":OUTPUT+key+".res","png_sha256":FileAccess.get_sha256(REVIEW+"art/"+key+".png"),"seed":seed_value}
		print("BAKED ",key)
	if sample_only:
		print("NPR_SAMPLE_OK ",images.size()); quit(); return
	if images.size()!=71: fail("Unexpected unique art count: "+str(images.size())); return
	var manifest := {"status":"COMPOSITIONS_APPROVED_NPR_IMPLEMENTED","style":"暗黑厚涂","style_sid":0,
		"pipeline":"src/art_generation/post/npr_pipeline.gd","post_shader_sha256":FileAccess.get_sha256("res://src/art_generation/source/shaders/post.gdshader"),
		"parameters":{"styleIndex":0,"styleSid":0,"palette":0,"px_scale":0.68,"madness":0.06,"bloom":0.75,"bloom_threshold":0.90,"bloom_knee":0.10,"grain":0.05,"vignette":0.55,"g_time":0.0},
		"source_manifest_sha256":FileAccess.get_sha256(SOURCE+"manifest.json"),"records":records,"images":images}
	FileAccess.open(REVIEW+"manifest.json",FileAccess.WRITE).store_string(JSON.stringify(manifest,"\t")+"\n")
	var registry := "extends RefCounted\n## Generated by tools/card-illustration-production/bake.gd; fixed art identity only.\nconst RECORDS := "+JSON.stringify(records,"\t")+"\nconst KEYS := "+JSON.stringify(images.keys(),"\t")+"\n"
	FileAccess.open(OUTPUT+"registry.gd",FileAccess.WRITE).store_string(registry)
	print("PAINTED_DECK_BAKE_OK: ",records.size()," surfaces / ",images.size()," fixed images")
	quit()
